# Variáveis usadas pelo n8n neste projeto. Copie para um arquivo fora do repositório
# e preencha os valores com os do README do desafio. Não versionar valores reais.

# Segredo do HMAC do webhook (opção B de configuracoes/README.md)
WEBHOOK_HMAC_SECRET=

# Necessário para ler $env no Code node (n8n 2.x bloqueia por padrão)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
