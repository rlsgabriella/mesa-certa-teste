# Variáveis usadas pelo processo do n8n neste projeto. Defina no terminal que inicia o n8n
# ou em um arquivo .env FORA do pacote de entrega (o .env real é ignorado pelo git).
# Não versionar valores reais.

# Segredo do HMAC do webhook, lido pelo Code node "Validar Assinatura HMAC" com $env.
# O valor está no material do desafio (webhook/README.md traz um placeholder).
MESA_CERTA_HMAC_SECRET=

# Necessário para ler $env no Code node (n8n 2.x bloqueia por padrão).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Necessário para o Code node usar require('crypto') (o task runner do n8n 2.x
# só libera módulos nativos listados aqui).
NODE_FUNCTION_ALLOW_BUILTIN=crypto
