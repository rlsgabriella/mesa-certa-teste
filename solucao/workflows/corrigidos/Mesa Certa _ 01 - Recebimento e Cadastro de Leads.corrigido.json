    {
      "parameters": {
        "jsCode": "\nconst lead = $input.item.json;\n\nconst mensagem = (lead.mensagem || '')\n  .toLowerCase()\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '');\n\nlet classificacao = 'revisao';\n\nif (/\\b(teste|testing|spam)\\b/.test(mensagem)) {\n  classificacao = 'nao_comercial';\n} else if (\n  /\\b(suporte|erro|problema|senha|bug|nao consigo acessar)\\b/.test(mensagem)\n) {\n  classificacao = 'suporte';\n} else if (\n  /\\b(fornecedor|embalagem|parceria comercial|oferecer meus servicos)\\b/.test(mensagem)\n) {\n  classificacao = 'nao_comercial';\n} else if (\n  /\\b(demonstracao|demo|conhecer o sistema|quero contratar|planos|precos)\\b/.test(mensagem)\n) {\n  classificacao = 'comercial';\n}\n\nreturn {\n  json: {\n    ...lead,\n    classificacao\n  }\n};\n"
      },
