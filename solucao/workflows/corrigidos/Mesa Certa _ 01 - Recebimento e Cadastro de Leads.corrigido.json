    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst segredo = $env.MESA_CERTA_HMAC_SECRET;\nif (!segredo) throw new Error('MESA_CERTA_HMAC_SECRET não configurado');\nconsole.log(\n  'Fingerprint do segredo:',\n  crypto.createHash('sha256').update(segredo, 'utf8').digest('hex')\n);\n\n// corpo bruto, lido do binário (Raw Body) via helper oficial — resolve o buffer certo\nconst rawBody = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst assinaturaRecebida = $json.headers['x-signature'] ?? '';\n\nconst assinaturaCalculada = 'sha256=' + crypto\n  .createHmac('sha256', segredo)\n  .update(rawBody)\n  .digest('hex');\n\nconst formatoValido = assinaturaRecebida.startsWith('sha256=');\n\nconst assinaturaValida = formatoValido\n  && assinaturaRecebida.length === assinaturaCalculada.length\n  && crypto.timingSafeEqual(\n    Buffer.from(assinaturaRecebida),\n    Buffer.from(assinaturaCalculada)\n  );\n\nreturn {\n  json: {\n    event_id: $json.body?.event_id,\n    assinatura_valida: assinaturaValida,\n    status: assinaturaValida ? 'ASSINATURA VALIDADA' : 'ASSINATURA INVALIDA',\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
